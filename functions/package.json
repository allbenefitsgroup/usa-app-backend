{
  "name": "usa-all-benefits-group-backend-functions",
  "description": "Firebase Cloud Functions backend for USA All Benefits Group",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node lib/server.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1057.0",
    "@open-wa/wa-automate": "^4.76.0",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "typescript": "^5.7.2"
  }
}
