APP_URL=https://your-app.example.com
SUPPORT_EMAIL=support@your-domain.com
WHATSAPP_ENABLED=false
JWT_SECRET=change-me-in-production-to-a-long-random-string

# Set these with Firebase Secret Manager, not with .env:
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# firebase functions:secrets:set EMAIL_API_KEY

# To enable WhatsApp notifications:
# firebase functions:secrets:set WHATSAPP_ENABLED --data true
